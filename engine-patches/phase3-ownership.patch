+static void PutWord(u8 *data, u32 value)
+{
+    data[0] = value; data[1] = value >> 8; data[2] = value >> 16; data[3] = value >> 24;
+}
+
+static void ResetOwnership(void)
+{
+    ZeroPlayerPartyMons();
+    memset(gPokemonStoragePtr, 0, sizeof(*gPokemonStoragePtr));
