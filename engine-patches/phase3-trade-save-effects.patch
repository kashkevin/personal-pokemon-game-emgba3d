+STATIC_ASSERT(offsetof(struct SaveBlock1, dexSeen) == 0x3598, TradeEffectDexSeenOffset);
+STATIC_ASSERT(offsetof(struct SaveBlock1, dexCaught) == 0x3619, TradeEffectDexCaughtOffset);
