+    BufferNativeMultiBattleVsScreenHealth(task);
+    for (u32 slot = 6; slot < 10; slot++) EXPECT_EQ(gTasks[task].data[slot], 0xFFF);
+    for (u32 local = 0; local < 2; local++)
