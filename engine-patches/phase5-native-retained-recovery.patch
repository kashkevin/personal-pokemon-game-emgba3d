+    EXPECT_EQ(Word(gMultiplayerBattleMailbox.response.data + 44), sizeof(trainer));
+    EXPECT_EQ(Word(gMultiplayerBattleMailbox.response.data + 64), MP_BATTLE_SUSPENDED | (1 << 8) | (MP_BATTLE_PREPARED << 16));
