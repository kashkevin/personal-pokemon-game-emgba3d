+        struct Pokemon mon = gParties[B_TRAINER_PLAYER][i];
+        u32 species = GetMonData(&mon, MON_DATA_SPECIES);
+        if (!PartyMonValid((const u8 *)&mon) || (!!species != (i < gPartiesCount[B_TRAINER_PLAYER]))) return MP_BATTLE_UNSAFE;
