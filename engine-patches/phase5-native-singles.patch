+#define MULTIPLAYER_SET_FIELD_SCHEMA(X) \
+    X(1, 2) X(2, 2) X(3, 16) X(8, 5) X(9, 1) X(10, 1) X(11, 1) X(12, 1) \
+    X(40, 4) X(42, 2)
