+    ResetBlockReceivedFlags(); sStarted = TRUE; sState = MP_BATTLE_RUNNING;
+    gWirelessCommType = 0; gReceivedRemoteLinkPlayers = TRUE; gLinkType = LINKTYPE_BATTLE;
+    gBattleTypeFlags = BATTLE_TYPE_LINK | BATTLE_TYPE_TRAINER;
