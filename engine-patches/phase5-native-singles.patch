+u16 MultiplayerBattle_ControllerRawSize(u8 command, u8 request)
+{
+    switch (command)
+    {
+#define SIZE(id, length) case id: return length;
+    MULTIPLAYER_MASTER_CONTROLLER_SCHEMA(SIZE)
+#undef SIZE
+    case CONTROLLER_SETMONDATA:
