+const u32 gMultiplayerEmergencySaveAbiVersion = 1;
 EWRAM_DATA volatile struct MultiplayerSaveMailbox gMultiplayerSaveMailbox = {0};
 static EWRAM_DATA struct MultiplayerSaveControl sLastCommand = {0};
