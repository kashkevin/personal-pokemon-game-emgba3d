     MP_SAVE_OK, MP_SAVE_BUSY, MP_SAVE_UNSAFE, MP_SAVE_MALFORMED, MP_SAVE_SESSION,
@@ -53,6 +55,7 @@ struct MultiplayerSaveMailbox {
 extern volatile struct MultiplayerSaveMailbox gMultiplayerSaveMailbox;
