+        CleanupControl(&f, MP_BATTLE_ADMISSION_CANCEL_READY); EXPECT_EQ(SubmitResume(&f), MP_BATTLE_OK);
+        CleanupControl(&f, MP_BATTLE_ADMISSION_CANCEL_HOLD); EXPECT_EQ(SubmitResume(&f), MP_BATTLE_OK);
